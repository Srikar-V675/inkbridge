# Copy to .env. Never commit .env.
GEMINI_API_KEY=
# Optional: override the recognition model (default gemini-3.5-flash-lite)
# GEMINI_MODEL=
# Optional: where the SQLite file and crop PNGs live (default: ./data)
INKBRIDGE_DATA_DIR=
# Optional: base of chunk deep links in notes (default http://localhost:5173); use a .local name
# INKBRIDGE_PUBLIC_URL=http://laptop.local:5173
# Optional: canvases the recognition worker may send to Gemini (comma-separated ids; test and eval
# pages only, the free tier may train on them). Unset = worker off.
# INKBRIDGE_RECOGNIZE_DOCUMENTS=
# Optional: seconds a canvas must be idle before its chunks are read (default 5)
# INKBRIDGE_RECOGNIZE_IDLE_S=
# Optional: vault folder the inkbridge-export skill writes notes into (the skill asks if unset)
# INKBRIDGE_VAULT=
