# Copy to .env. Never commit .env.
GEMINI_API_KEY=
# Optional: override the recognition model (default gemini-3.5-flash-lite)
# GEMINI_MODEL=
# Optional: where the SQLite file and crop PNGs live (default: ./data)
INKBRIDGE_DATA_DIR=
# Optional: built web app the API serves; default web/dist when it exists (set before the API starts)
# INKBRIDGE_WEB_DIST=
# Optional: base of chunk deep links in notes (default http://localhost:8000, the served origin); use a .local name
# INKBRIDGE_PUBLIC_URL=http://laptop.local:8000
# Optional: canvases the recognition worker may send to Gemini (comma-separated ids; test and eval
# pages only, the free tier may train on them). Unset = worker off.
# INKBRIDGE_RECOGNIZE_DOCUMENTS=
# Optional: seconds a canvas must be idle before its chunks are read (default 5)
# INKBRIDGE_RECOGNIZE_IDLE_S=
# Optional: vault folder the inkbridge-export skill writes notes into (the skill asks if unset)
# INKBRIDGE_VAULT=
# Optional: keep a chunk's id when this fraction of it survives in one cluster (0.6; unset = off)
# INKBRIDGE_CHUNK_CONTAINMENT=
# Optional: start an agent for each pending Ask question (only "claude" exists; unset = pull path only)
# INKBRIDGE_RUNNER=claude
# INKBRIDGE_CLAUDE_BIN=claude
# INKBRIDGE_RUNNER_MCP_CONFIG=/path/to/mcp.json   # required with the runner; must list the inkbridge server AND the vault server (the runner uses --strict-mcp-config)
# INKBRIDGE_RUNNER_MCP_NAME=inkbridge
# INKBRIDGE_RUNNER_VAULT_TOOLS=   # full read-only tool names, each with a search/read/get/list word, for example mcp__vault__obsidian_search
# INKBRIDGE_RUNNER_TIMEOUT_S=180

# Optional: 1 mounts /debug/device-log and /debug/echo and writes data/logs/device.jsonl (INK-102, decision 0059). Off = routes absent.
# INKBRIDGE_DEVICE_LOG=1
